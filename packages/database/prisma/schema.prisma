// Teacher Paper Maker — Prisma schema (Phase 1).
// Additive migrations only. Index userId / status / createdAt on relevant tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  // Null for OAuth-only accounts. Never stores plaintext.
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  profile        TeacherProfile?
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  documents      Document[]
  generationJobs GenerationJob[]

  @@index([createdAt])
  @@map("users")
}

model TeacherProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  schoolName          String?
  preferredCurriculum String?
  preferredGrades     String[] @default([])
  preferredSubjects   String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("teacher_profiles")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  // Stores a SHA-256 hash of the token, never the raw token.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Document {
  id          String         @id @default(cuid())
  userId      String
  type        String         @default("WORKSHEET")
  title       String
  curriculum  String?
  grade       String?
  subject     String?
  chapter     String?
  topic       String?
  status      DocumentStatus @default(DRAFT)
  starred     Boolean        @default(false)
  contentJson Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions      Question[]
  generationJobs GenerationJob[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

model GenerationJob {
  id            String           @id @default(cuid())
  userId        String
  documentId    String
  provider      String
  model         String
  requestType   String
  status        GenerationStatus @default(PENDING)
  inputTokens   Int?
  outputTokens  Int?
  estimatedCost Float?
  latencyMs     Int?
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([documentId])
  @@index([status])
  @@map("generation_jobs")
}

model Question {
  id           String    @id @default(cuid())
  documentId   String
  document     Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type         String
  question     String    @db.Text
  answerJson   Json
  marks        Int
  difficulty   String
  bloomLevel   String
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentId])
  @@index([deletedAt])
  @@map("questions")
}

// --- Auth.js (NextAuth) adapter models ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
