# ---------------------------------------------------------------------------
# Teacher Paper Maker — environment template. Copy to .env and fill in values.
# NEVER commit a real .env. No secrets belong in source control.
# ---------------------------------------------------------------------------

# Node
NODE_ENV="development"

# App URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (PostgreSQL)
DATABASE_URL="postgresql://tpm:tpm@localhost:5432/tpm?schema=public"

# Auth (Auth.js / NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-random-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (from Google Cloud Console). Dummy values are fine for dev.
AUTH_GOOGLE_ID="google-oauth-client-id"
AUTH_GOOGLE_SECRET="google-oauth-secret"

# Email (password reset + welcome; Mailpit in dev)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@teacherpaper.local"

# Redis (BullMQ job queue)
REDIS_URL="redis://localhost:6379"

# AI provider (worksheet generation). Leave unset in dev if not generating.
ANTHROPIC_API_KEY=""
